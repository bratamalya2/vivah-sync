{
  "name": "vivahsync",
  "version": "0.0.0",
  "private": true,
  "description": "Operational + financial system of record for Indian wedding planning agencies",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "worker": "npm run start --workspace apps/worker",
    "db:check": "node packages/db/scripts/capability-check.mjs",
    "db:apply": "node packages/db/scripts/apply.mjs",
    "db:seed": "node --import tsx packages/db/scripts/seed.ts",
    "test": "npm run test --workspace packages/db"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
