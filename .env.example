# =============================================================================
# VivahSync — environment configuration (EXAMPLE / TEMPLATE)
#
# Copy this file and fill in real values:
#   apps/web    -> .env.local
#   apps/worker -> .env
#
# Commit ONLY this .example file. Never commit a filled-in .env / .env.local.
#
# SECURITY: two values below defeat all tenant isolation if leaked —
#   SUPABASE_SERVICE_ROLE_KEY  and  WORKER_DATABASE_URL
# They must never be exposed to the browser and must never carry a NEXT_PUBLIC_
# prefix. See the "Which service gets what" note at the bottom.
# =============================================================================


# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Date-triggered milestones, cash-flow day buckets and all cron schedules must
# run on IST regardless of where Render hosts the process (Singapore).
TZ=Asia/Kolkata


# -----------------------------------------------------------------------------
# Supabase project  (cloud-hosted, region ap-south-1 / Mumbai)
# Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# SERVER-ONLY. Bypasses Row Level Security entirely.
# Used only by (a) the worker and (b) narrow SECURITY DEFINER RPCs such as the
# Cashfree webhook ledger insert. Never ship to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Supabase CLI — local dev only, for applying the canonical SQL migrations.
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_ACCESS_TOKEN=<personal-access-token>

# Database password (server-only — NEVER prefix with NEXT_PUBLIC_).
# Already embedded in the connection strings below; kept separately only so the
# Supabase CLI (`supabase db push`) can run non-interactively.
SUPABASE_DB_PASSWORD=<db-password>


# -----------------------------------------------------------------------------
# Postgres connections
#
# DATABASE_URL         Supavisor TRANSACTION pooler (port 6543) — used by the web app.
#                      Transaction mode is REQUIRED: withUser() sets
#                      request.jwt.claims transaction-locally, and session-mode
#                      pooling would carry one user's identity into the next
#                      request (a cross-tenant leak). Prisma over pgbouncer also
#                      needs ?pgbouncer=true&connection_limit=1
#
# DIRECT_URL           Direct/session connection (port 5432) — schema tooling only
#                      (`prisma db pull` introspection). Not used at runtime.
#
# WORKER_DATABASE_URL  The worker's privileged, RLS-bypassing connection.
#                      Keep this OFF the public web tier.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
WORKER_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres


# -----------------------------------------------------------------------------
# Cashfree — collects VivahSync's OWN SaaS fee (per-wedding / subscription).
#
# This is plain merchant collection of your own revenue: no fund custody, no
# vendor KYC, no split payouts. Escrow / split routing is phase 2.
# -----------------------------------------------------------------------------
CASHFREE_ENV=SANDBOX
CASHFREE_APP_ID=<cashfree-app-id>
CASHFREE_SECRET_KEY=<cashfree-secret-key>

# Verify the signature on EVERY inbound webhook before acting on it, and dedupe
# by event id — a forged or replayed "payment succeeded" must never grant entitlement.
CASHFREE_WEBHOOK_SECRET=<webhook-signing-secret>


# -----------------------------------------------------------------------------
# Transactional email — the v1 notification channel (WhatsApp/SMS deferred)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=<resend-api-key>
EMAIL_FROM="VivahSync <no-reply@yourdomain.in>"
EMAIL_REPLY_TO=support@yourdomain.in


# -----------------------------------------------------------------------------
# VivahSync's own tax identity — used for the VivahSync -> planner GST invoice.
#
# NOTE: each PLANNER agency's own GSTIN and invoice series live in the database
# (org_tax_profiles), NOT here. This block is only the platform's own entity.
# -----------------------------------------------------------------------------
PLATFORM_LEGAL_NAME=<your registered legal entity name>
PLATFORM_GSTIN=<your 15-character GSTIN>
PLATFORM_STATE_CODE=<2-digit GST state code>
PLATFORM_SAC_CODE=998314
PLATFORM_GST_RATE=18
PLATFORM_INVOICE_PREFIX=VS
PLATFORM_ADDRESS=<registered address printed on the invoice>


# -----------------------------------------------------------------------------
# Pricing — headline amounts in whole rupees, EXCLUSIVE of GST.
# 18% is added at checkout (e.g. 5999 -> 7078.82 payable).
# Canonical plan rows live in the `plans` table; these seed the bootstrap.
# -----------------------------------------------------------------------------
PRICE_PER_WEDDING_INR=799
PRICE_MONTHLY_INR=5999
PRICE_SIX_MONTH_INR=24999


# -----------------------------------------------------------------------------
# Domain rules
# -----------------------------------------------------------------------------
# FR-801.1 — how close an event must be before unfulfilled vendors / unresolved
# issues escalate onto the risk dashboard.
RISK_PROXIMITY_DAYS=14


# -----------------------------------------------------------------------------
# Observability — the worker's scheduled jobs are this system's dominant
# silent-failure surface, so job-level alerting is strongly recommended.
# -----------------------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info


# =============================================================================
# Which service gets what (Render env groups)
#
#   WEB  (apps/web)     NEXT_PUBLIC_*, DATABASE_URL, CASHFREE_*, EMAIL_*,
#                       PLATFORM_*, PRICE_*, RISK_PROXIMITY_DAYS,
#                       SUPABASE_SERVICE_ROLE_KEY  (webhook RPC only)
#
#   WORKER (apps/worker) WORKER_DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
#                        EMAIL_*, RISK_PROXIMITY_DAYS, TZ
#
#   LOCAL ONLY          SUPABASE_ACCESS_TOKEN, SUPABASE_PROJECT_REF, DIRECT_URL
#
# Keep one source of truth per credential. The overview records a password
# literal drifting between two files and surfacing as a confusing 28P01 auth
# error — with web and worker on separate Render services that risk doubles.
# =============================================================================
